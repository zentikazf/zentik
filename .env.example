# URL of the backend API (Railway)
NEXT_PUBLIC_API_URL=https://your-api.railway.app

# Desarrollo local con backend remoto (proxy activo solo con pnpm dev):
# NEXT_PUBLIC_API_URL=http://localhost:3002
# DEV_BACKEND_URL=https://your-api.railway.app

# ── Facturación Fortaleza (portal billing) ──────────────────────────────
# Los datos salen de snapshots mensuales en src/data/billing/ (ver README ahí).
# Esta ruta antigua usa snapshots; Facturación v2 consulta la API desde el servidor.
#
# Solo para DESARROLLO local sin backend: saltea la validación de sesión del
# route handler /api/portal/billing. Nunca tiene efecto en producción.
# BILLING_DEV_SKIP_AUTH=1

# Facturación v2: consulta Botmaker desde el servidor de Next.js.
# Token privado; nunca usar NEXT_PUBLIC_ para esta variable.
BOTMAKER_ACCESS_TOKEN=
